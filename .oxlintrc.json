{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vitest", "import"],
  "env": { "node": true },
  "options": { "typeAware": true },
  "categories": { "correctness": "error", "suspicious": "warn" },
  "ignorePatterns": ["dist/**", "coverage/**"]
}
