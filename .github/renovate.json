{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "docker:enableMajor", "schedule:earlyMondays"],
  "ignorePresets": [":pinDevDependencies"],
  "timezone": "Europe/Berlin",
  "automerge": false,
  "platformAutomerge": false,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "groupName": "docker-digest",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "groupName": "github-actions-digest",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"]
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "groupName": "npm-non-major",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor", "lockFileMaintenance"],
      "automerge": true
    }
  ]
}
