{
  "name": "session-insight",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight HTTP service for session location and device enrichment.",
  "homepage": "https://github.com/kilianlabs/session-insight#readme",
  "bugs": {
    "url": "https://github.com/kilianlabs/session-insight/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilianlabs/session-insight.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "oxlint . --fix",
    "lint-check": "oxlint .",
    "format": "oxfmt .",
    "format-check": "oxfmt --check .",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "check": "pnpm type-check && pnpm lint-check && pnpm format-check && pnpm test && pnpm openapi:check && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.2.0",
    "mmdb-lib": "^3.0.3",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
